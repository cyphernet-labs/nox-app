<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash in OS dark mode. Brand-fixed dark background and
         no icon, same as values-v31 (the splash is dark regardless of theme). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/nox_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
