<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) system SplashScreen API. By default it draws the app
         launcher icon centered on the splash; we suppress that (transparent icon)
         so the native splash is JUST the dark brand background (FR-005: splash is
         always dark), and the NOX logo animates in the Flutter SplashPage. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/nox_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
