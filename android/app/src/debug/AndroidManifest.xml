<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- android:usesCleartextTraffic was here until feature 036. It existed
         because the transport was plain `ws://` and Android has blocked
         cleartext by default since API 28, so a debug build could not reach a
         dev server at all. The transport is `wss` now, on both halves, so the
         exception has nothing left to permit - and leaving it would keep a
         debug build able to fall back to a channel anyone on the network can
         read. -->
</manifest>
